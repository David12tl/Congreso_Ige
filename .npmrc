# Forzar instalación de optionalDependencies de sharp para evitar ERR_DLOPEN_FAILED en Vercel (linux-x64).
# sharp resuelve su binding nativo desde @img/sharp-<plataforma>-<arch>. Sin esto, npm en entornos de
# compilación (y en desarrollo Windows/macOS) puede omitir el paquete opcional de otra plataforma.
supportedArchitectures=linux,osx,win32
optionalDependencies=true
engine-strict=true
